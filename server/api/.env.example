# Copy to .env for local dev (never commit .env). On Railway, set these under the service's Variables tab.
PORT=8787
# PUBLIC_URL=https://your-api.up.railway.app

# Database (docker compose). Leave unset to use an embedded in-memory Postgres (data is lost on restart).
DATABASE_URL=postgres://muse:muse@localhost:5432/muse

# Storage: MinIO from docker compose standing in for Cloudflare R2
STORAGE=s3
R2_BUCKET=muse
R2_ACCESS_KEY_ID=museminio
R2_SECRET_ACCESS_KEY=museminio-secret
S3_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
# For real R2 instead: R2_ACCOUNT_ID=..., no S3_ENDPOINT, no S3_FORCE_PATH_STYLE

# Dev conveniences: seed data like server/mock, /v1/dev/*, simulated balance. Never on Railway.
DEV_MODE=true
DEV_SEED=true
BALANCE_MODE=simulated

# GPU: simulated (free) or runpod
GPU_MODE=simulated
# RUNPOD_API_KEY=
# RUNPOD_NETWORK_VOLUME_ID=
# RUNPOD_IMAGE=
# RUNPOD_START_CMD=

# Images: simulated | fal | custom-http
IMAGE_PROVIDER=simulated
# FAL_KEY=
# IMAGE_MODEL=fal-ai/bytedance/seedream/v4/edit
