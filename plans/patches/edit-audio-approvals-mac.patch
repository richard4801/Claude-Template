diff --git a/mac/MuseCore/Sources/MuseCore/Edit/EditApprovals.swift b/mac/MuseCore/Sources/MuseCore/Edit/EditApprovals.swift
new file mode 100644
index 00000000..b25a358e
--- /dev/null
+++ b/mac/MuseCore/Sources/MuseCore/Edit/EditApprovals.swift
@@ -0,0 +1,61 @@
+import Foundation
+
+// Paid helpers Claude asked for, across ALL of the owner's open edit sessions (owner issue ci_e546642a4026, 2026-11-12:
+// an Approve card for a helper on another edit never showed while the Edit page had a different session open). The
+// Claude panel lists them whichever edit is open, each naming its edit, and answers them by session id
+// (POST /v1/edit-sessions/{id}/pending/{pid}) without switching edits.
+
+/// One paid helper waiting for the owner's yes, and the edit it belongs to.
+public struct EditApproval: Identifiable, Hashable, Sendable {
+    public var sessionId: String
+    public var takeId: String
+    public var pending: EditPending
+    public var id: String { "\(sessionId)/\(pending.id)" }
+    public init(sessionId: String, takeId: String, pending: EditPending) {
+        self.sessionId = sessionId; self.takeId = takeId; self.pending = pending
+    }
+
+    /// "Allow · $0.40": the price on the action.
+    public var allowLabel: String { "Allow · $" + String(format: "%.2f", pending.estimateUsd) }
+}
+
+/// The waiting ones, oldest first (the order Claude asked).
+public struct EditApprovalList: Hashable, Sendable {
+    public private(set) var items: [EditApproval] = []
+    public init() {}
+
+    /// Everything waiting in these sessions (GET /v1/edit-sessions: open sessions with their pending helpers).
+    public mutating func replace(sessions: [EditSession]) {
+        items = sessions.flatMap { s in s.pending.filter(\.isWaiting).map { EditApproval(sessionId: s.id, takeId: s.takeId, pending: $0) } }
+        sort()
+    }
+
+    /// A live `pending` event of a session: waiting → listed (or updated), anything else → gone. `takeId` names the edit
+    /// when the session isn't listed yet (nil: keep what is known, else unnamed until the next reload).
+    public mutating func apply(sessionId: String, takeId: String?, _ p: EditPending) {
+        let key = "\(sessionId)/\(p.id)"
+        guard p.isWaiting else { items.removeAll { $0.id == key }; return }
+        if let i = items.firstIndex(where: { $0.id == key }) {
+            items[i].pending = p
+        } else {
+            let tid = takeId ?? items.first { $0.sessionId == sessionId }?.takeId ?? ""
+            items.append(EditApproval(sessionId: sessionId, takeId: tid, pending: p))
+            sort()
+        }
+    }
+
+    /// Answered here (or elsewhere): off the list.
+    public mutating func remove(_ id: String) { items.removeAll { $0.id == id } }
+
+    public var count: Int { items.count }
+    public var isEmpty: Bool { items.isEmpty }
+
+    private mutating func sort() { items.sort { ($0.pending.createdAt, $0.id) < ($1.pending.createdAt, $1.id) } }
+
+    /// The edit's name as the card says it: the take's title, "New project" for a blank one, "an edit" when unknown.
+    public static func editName(takeId: String, title: String?) -> String {
+        if takeId == EditV2.blankSourceId { return "New project" }
+        if let t = title?.trimmingCharacters(in: .whitespacesAndNewlines), !t.isEmpty { return t }
+        return "an edit"
+    }
+}
diff --git a/mac/MuseCore/Sources/MuseCore/Edit/MediaSniff.swift b/mac/MuseCore/Sources/MuseCore/Edit/MediaSniff.swift
new file mode 100644
index 00000000..a67a4808
--- /dev/null
+++ b/mac/MuseCore/Sources/MuseCore/Edit/MediaSniff.swift
@@ -0,0 +1,99 @@
+import Foundation
+
+// What a file really is, from its first bytes, not its name (owner issue ci_f99f93616ece, 2026-11-12: a song that was raw
+// ADTS AAC, sound only, named .mp4, was read as a video and Edit said only "Couldn't add that file"). Used by Edit's Add
+// (Uploads, Music) and by upload_local_file. An MP4 container needs its tracks to decide: the app reads them
+// (AVFoundation) and passes `hasVideo` / `hasAudio`.
+
+public enum MediaSniff {
+    /// Enough of the file's start for every check here.
+    public static let headerBytes = 64
+
+    public enum Format: Equatable, Sendable {
+        case adts, mp3, wav, aiff, flac
+        /// ISO base media (MP4, M4A, MOV, HEIC): the `ftyp` brand decides pictures; tracks decide video vs sound.
+        case isoMedia(brand: String)
+        case png, jpeg, webp
+        case unknown
+    }
+
+    /// The format of a file from its first bytes.
+    public static func format(_ data: Data) -> Format {
+        let b = [UInt8](data.prefix(headerBytes))
+        func ascii(_ at: Int, _ n: Int) -> String? {
+            guard b.count >= at + n else { return nil }
+            return String(bytes: b[at..<at + n], encoding: .ascii)
+        }
+        if b.count >= 8, ascii(4, 4) == "ftyp" { return .isoMedia(brand: ascii(8, 4) ?? "") }
+        if b.starts(with: [0x89, 0x50, 0x4E, 0x47]) { return .png }
+        if b.starts(with: [0xFF, 0xD8, 0xFF]) { return .jpeg }
+        if ascii(0, 4) == "RIFF", ascii(8, 4) == "WAVE" { return .wav }
+        if ascii(0, 4) == "RIFF", ascii(8, 4) == "WEBP" { return .webp }
+        if ascii(0, 4) == "FORM", let t = ascii(8, 4), t == "AIFF" || t == "AIFC" { return .aiff }
+        if ascii(0, 4) == "fLaC" { return .flac }
+        if ascii(0, 3) == "ID3" { return .mp3 }
+        if b.count >= 2, b[0] == 0xFF {
+            // ADTS (AAC): 12-bit sync 0xFFF, layer 00. MPEG audio (MP3): 11-bit sync, layer not 00.
+            if b[1] & 0xF6 == 0xF0 { return .adts }
+            if b[1] & 0xE0 == 0xE0, (b[1] >> 1) & 0x3 != 0 { return .mp3 }
+        }
+        return .unknown
+    }
+
+    /// What MUSE does with a file: its kind, the content type it is uploaded as and the extension it must carry on this
+    /// Mac (AVFoundation reads by extension).
+    public struct Verdict: Equatable, Sendable {
+        public var kind: EditSuite.UploadKind
+        public var contentType: String
+        public var ext: String
+        public init(_ kind: EditSuite.UploadKind, _ contentType: String, _ ext: String) {
+            self.kind = kind; self.contentType = contentType; self.ext = ext
+        }
+    }
+
+    /// The one line when a file can't be used.
+    public static let unreadable = "This file has no video or sound MUSE can read."
+
+    private static let heicBrands: Set<String> = ["heic", "heix", "hevc", "hevx", "heim", "heis", "mif1", "msf1"]
+    private static let audioBrands: Set<String> = ["M4A ", "M4B ", "M4P "]
+
+    /// The verdict, from the format and (for an MP4 container) its tracks; `fileExtension` only when the bytes say
+    /// nothing (nil when MUSE can't use the file).
+    public static func verdict(_ f: Format, fileExtension: String, hasVideo: Bool? = nil, hasAudio: Bool? = nil) -> Verdict? {
+        switch f {
+        case .adts: return Verdict(.audio, "audio/aac", "aac")
+        case .mp3: return Verdict(.audio, "audio/mpeg", "mp3")
+        case .wav: return Verdict(.audio, "audio/wav", "wav")
+        case .aiff: return Verdict(.audio, "audio/aiff", "aiff")
+        case .flac: return Verdict(.audio, "audio/flac", "flac")
+        case .png: return Verdict(.picture, "image/png", "png")
+        case .jpeg: return Verdict(.picture, "image/jpeg", "jpg")
+        case .webp: return Verdict(.picture, "image/webp", "webp")
+        case .isoMedia(let brand):
+            if heicBrands.contains(brand) { return Verdict(.picture, "image/heic", "heic") }
+            let mov = brand == "qt  "
+            if hasVideo == true { return Verdict(.video, mov ? "video/quicktime" : "video/mp4", mov ? "mov" : "mp4") }
+            if hasAudio == true { return Verdict(.audio, "audio/mp4", "m4a") }
+            if hasVideo == false && hasAudio == false { return nil }
+            // Tracks not read: the brand's word.
+            return audioBrands.contains(brand) ? Verdict(.audio, "audio/mp4", "m4a") : Verdict(.video, mov ? "video/quicktime" : "video/mp4", mov ? "mov" : "mp4")
+        case .unknown:
+            let e = fileExtension.lowercased()
+            switch EditSuite.UploadBin.kind(ofExtension: e) {
+            case .video: return Verdict(.video, e == "mov" ? "video/quicktime" : "video/mp4", e == "mov" ? "mov" : "mp4")
+            case .picture: return e == "heic" ? Verdict(.picture, "image/heic", "heic") : nil // other pictures have magic bytes
+            case .audio: return nil // every sound format MUSE takes has magic bytes (an AAC/M4A without them isn't readable)
+            case nil: return nil
+            }
+        }
+    }
+
+    /// True when the file must be read through a copy named with the verdict's extension (AVFoundation picks its reader
+    /// from the name: raw AAC named .mp4 won't open, an M4A named .mp4 will).
+    public static func needsRename(fileExtension: String, _ v: Verdict) -> Bool {
+        let e = fileExtension.lowercased()
+        let families: [Set<String>] = [["jpg", "jpeg"], ["mp4", "m4v", "m4a", "mov"], ["aif", "aiff", "aifc"], ["heic", "heif"]]
+        if e == v.ext { return false }
+        return !families.contains { $0.contains(e) && $0.contains(v.ext) }
+    }
+}
