From: Claude <noreply@anthropic.com>
Date: Sat, 14 Nov 2026 22:07:05 +0000
Subject: [PATCH] Photo: the empty stage's line as in the approved frames ("1
 to 4 photos per run", then "<n> photos, one run" once filled)

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
Claude-Session: https://claude.ai/code/session_01Py2rxoXQmfbR7CXwb939GC
---
 .../studio/muse/app/ui/screens/suite/composer/PhotoTab.kt       | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/android/app/src/main/kotlin/studio/muse/app/ui/screens/suite/composer/PhotoTab.kt b/android/app/src/main/kotlin/studio/muse/app/ui/screens/suite/composer/PhotoTab.kt
index 0de18f09..0b9a7414 100644
--- a/android/app/src/main/kotlin/studio/muse/app/ui/screens/suite/composer/PhotoTab.kt
+++ b/android/app/src/main/kotlin/studio/muse/app/ui/screens/suite/composer/PhotoTab.kt
@@ -101,7 +101,7 @@ fun PhotoStage(ui: ComposerUi, modifier: Modifier, wide: Boolean) {
                 Spacer(Modifier.height(14.dp))
                 T(if (busy) "Making ${PhotoRules.noun(count)}…" else "Your photos appear here", m.scale.label.copy(fontWeight = FontWeight.SemiBold), m.roles.ink, maxLines = 1)
                 Spacer(Modifier.height(4.dp))
-                T(if (busy) "They land here when they're ready" else "1 to ${PhotoRules.MAX_COUNT} photos per run", m.scale.caption, m.roles.ink2, maxLines = 1)
+                T(if (busy) "They land here when they're ready" else if (ui.photo?.request != null) "${PhotoRules.noun(count)}, one run" else "1 to ${PhotoRules.MAX_COUNT} photos per run" /* the approved frames: empty, then filled */, m.scale.caption, m.roles.ink2, maxLines = 1)
             }
             return@Column
         }
